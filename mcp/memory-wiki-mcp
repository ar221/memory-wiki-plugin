def call_tool(name: str, args: Dict[str, Any]) -> str:
    root = wiki_root()

    if name == "wiki_path":
        return str(root)

    if name == "wiki_search":
        extra: List[str] = []
        if args.get("glob"):
            extra += ["--glob", str(args["glob"])]
        if args.get("limit"):
            extra += ["--max", str(int(args["limit"]))]
        return _run_tool("wiki-search", [str(args["query"]), *extra])

    if name == "wiki_read":
        target = (root / str(args["page"])).resolve()
        try:
            target.relative_to(root)
        except ValueError:
            return f"error: refusing to read outside the wiki root: {target}"
        if not target.is_file() and target.suffix != ".md":
            alt = target.with_suffix(".md")
            if alt.is_file():
                target = alt
        if not target.is_file():
            return f"error: no such page: {target}"
        return target.read_text(encoding="utf-8")

    if name == "wiki_lint":
        chunks = [f"$ {s}\n{_run_tool(s, [])}" for s in
                  ("wiki-check-links", "wiki-orphans", "wiki-lint")]
        chunks.append(
            "NOTE: 2 of 7 checks are mechanized. Stale pages, contradictions, "
            "missing citations, open-loop promotion and duplicate concepts still "
            "require an agent pass."
        )
        return "\n\n".join(chunks)

    if name == "wiki_context_pack":
        extra = ["--max-files", str(int(args["max_files"]))] if args.get("max_files") else []
        return _run_tool("wiki-context-pack", [str(args["topic"]), *extra])

    if name == "wiki_log":
        argv = [str(args["type"]), str(args["title"])]
        for b in args.get("bullets") or []:
            argv += ["-b", str(b)]
        if args.get("date"):
            argv += ["--date", str(args["date"])]
        return _run_tool("wiki-log", argv)

    if name == "wiki_new_page":
        argv = [str(args["kind"]), str(args["title"])]
        if args.get("summary"):
            argv += ["--summary", str(args["summary"])]
        return _run_tool("wiki-new-page", argv)

    if name == "wiki_ingest_artifact":
        src = Path(str(args["path"])).expanduser()
        if not src.is_file():
            return f"error: no such file: {src}"
        refusal = _ingest_refusal(src)
        if refusal:
            return refusal
        dest_dir = root / "artifacts"
        dest_dir.mkdir(parents=True, exist_ok=True)
        # Never overwrite. Date-prefix like the original plugin, then add a
        # numeric suffix on collision. An agent-facing overwrite flag is a
        # silent-data-loss hazard in a git-committed corpus.
        today = _dt.date.today().isoformat()
        dest = dest_dir / f"{today}-{src.name}"
        if dest.exists():
            stem, ext = Path(src.name).stem, Path(src.name).suffix
            n = 2
            while (dest_dir / f"{today}-{stem}-{n}{ext}").exists():
                n += 1
            dest = dest_dir / f"{today}-{stem}-{n}{ext}"
        shutil.copy2(src, dest)
        bullets = ["-b", f"Ingested `artifacts/{dest.name}` from `{src}`."]
        if args.get("note"):
            bullets += ["-b", str(args["note"])]
        log = _run_tool("wiki-log", ["ingest", f"Artifact: {dest.name}", *bullets])
        return f"ingested -> {dest}\n{log}"

    return f"error: unknown tool {name!r}"


# ---------------------------------------------------------------------------
# JSON-RPC / MCP plumbing
# ---------------------------------------------------------------------------

def _send(msg: Dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(msg, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def _result(req_id: Any, result: Dict[str, Any]) -> None:
    _send({"jsonrpc": "2.0", "id": req_id, "result": result})


def _error(req_id: Any, code: int, message: str) -> None:
    _send({"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}})


def handle(msg: Dict[str, Any]) -> None:
    method = msg.get("method")
    req_id = msg.get("id")
    params = msg.get("params") or {}

    if method == "initialize":
        proto = params.get("protocolVersion") or DEFAULT_PROTOCOL
        _result(req_id, {
            "protocolVersion": proto,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
        })
        return

    if method in ("notifications/initialized", "initialized"):
        return

    if method == "ping":
        _result(req_id, {})
        return

    if method == "tools/list":
        _result(req_id, {"tools": TOOLS})
        return

    if method == "tools/call":
        name = params.get("name") or ""
        args = params.get("arguments") or {}
        try:
            text = call_tool(name, args)
            is_err = text.startswith("error:")
        except Exception as exc:  # never kill the server on one bad call
            text = f"error: {type(exc).__name__}: {exc}"
            is_err = True
        _result(req_id, {"content": [{"type": "text", "text": text}], "isError": is_err})
        return

    if req_id is not None:
        _error(req_id, -32601, f"method not found: {method}")


def main() -> int:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(msg, list):
            for m in msg:
                handle(m)
        elif isinstance(msg, dict):
            handle(msg)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        raise SystemExit(0)
